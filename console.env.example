# Testbed Console configuration, copy this file and fill it in:
#
#   cp console.env.example console.env
#   ./deploy/make-cert.sh                       # writes the TLS pair
#   .venv/bin/python -m console set-password    # writes CONSOLE_PASSWORD_HASH
#
# console.env is git-ignored because it holds the password hash and the session
# secret. This example carries placeholders only, never a real credential.
#
# PRECEDENCE: the real environment always wins. A shell `export`, a systemd
# `Environment=` line and a Kubernetes Secret all beat this file, which is a
# default layer underneath. That way installing the file cannot change how an
# existing deployment behaves.
#
# This file must list every CONSOLE_* variable the code reads. A test compares it
# against console.variables.known_env_vars() in BOTH directions, so adding a
# variable to the code means adding it here.
#
# TWO RULES ABOUT THE FORMAT, both learned the hard way:
#
#   1. A comment goes on its OWN LINE, above the variable. systemd's
#      EnvironmentFile= does not strip a trailing `# comment` the way dotenv
#      does, and this file is loaded that way by deploy/testbed-console.service.
#      `CONSOLE_LOG_LEVEL=info  # the level` becomes the literal value
#      "info  # the level", and uvicorn refuses to start. A test enforces this.
#   2. A blank is KEY="", never bare. `KEY=` followed by a comment on the same
#      line has the same problem; empty means unset, which means the default or
#      the documented refusal.
#
# Everything here is read where uvicorn runs, on the console host, not on
# joule, not on the UE.

# --- the server ---------------------------------------------------------------

# Listen address. 0.0.0.0 for the lab LAN; 127.0.0.1 to reach it over ssh -L only.
CONSOLE_BIND=0.0.0.0

# HTTPS port (SE-01: HTTPS only, nothing is served over plain HTTP).
CONSOLE_PORT=8443

# REQUIRED. Written by deploy/make-cert.sh. The console refuses to serve without
# both of these, unless started with `serve --insecure` behind a tunnel.
CONSOLE_TLS_CERT=/home/oai-gnb/.config/testbed-console/tls/console.crt
CONSOLE_TLS_KEY=/home/oai-gnb/.config/testbed-console/tls/console.key

# uvicorn log level: critical, error, warning, info, debug, trace.
CONSOLE_LOG_LEVEL=info

# --- login and sessions -------------------------------------------------------

# REQUIRED. The argon2id hash that `python -m console set-password` prints. The
# plain password is never stored, logged or echoed (SE-03).
CONSOLE_PASSWORD_HASH=""

# REQUIRED. 64 hex characters: openssl rand -hex 32. Changing it logs you out.
CONSOLE_SESSION_SECRET=""

# --- ETHOS --------------------------------------------------------------------

# ETHOS stays bound to loopback (SE-07); the console reaches it there.
CONSOLE_ETHOS_URL=http://127.0.0.1:8081

# Timeout for an ordinary read, in seconds.
CONSOLE_ETHOS_TIMEOUT_S=10

# Timeout for a read that reaches the testbed over SSH, in seconds.
CONSOLE_ETHOS_SLOW_TIMEOUT_S=60
# An action ETHOS performs on the testbed, not a read. Attaching a handset
# toggles the radio, waits for it to settle and reads the address back, which
# is minutes: a shorter timeout would abandon an act that is still running.
CONSOLE_ETHOS_ACT_TIMEOUT_S=900

# GET /runs takes no limit and returns every manifest, re-reading each one from
# disk, so the console caches the list for this many seconds.
CONSOLE_RUNS_CACHE_S=20

# GET /deploy/status is an SSH round trip to the KVM; cache it for this long.
CONSOLE_STATUS_CACHE_S=15

# --- read-only stand-in for an ETHOS endpoint that does not exist yet ---------
# A plain data file on this host, read and never written, holding no credential.
# It goes away when its ETHOS endpoint lands; see docs/ethos-backlog.md. Set it
# to "" to turn the stand-in off.

# Which options can actually be deployed, and why not, until GET /catalogue (B4).
CONSOLE_DEPLOY_PROFILES=/home/oai-gnb/ravi-ethos-rApp/deployment/deploy_profiles.yaml

# Used only to render a copy-able `python -m campaign` command on the plan page.
CONSOLE_ETHOS_REPO=/home/oai-gnb/ravi-ethos-rApp

# --- console's own storage ----------------------------------------------------

# Saved test plans, deliberately outside the repository.
CONSOLE_PLANS_DIR=~/testbed-console-data/plans

# --- presentation -------------------------------------------------------------

# Linked from the Overview, never embedded and never modified.
CONSOLE_GRAFANA_URL=http://192.168.8.69:30489

# Display time zone. Everything stored and exchanged stays UTC (GL-06).
CONSOLE_TZ=Asia/Taipei

# --- the env file itself ------------------------------------------------------
# CONSOLE_ENV_FILE is read from the real environment only, because it names this
# file. Setting it here would have no effect.
# CONSOLE_ENV_FILE=/etc/testbed-console/console.env
