  "couplings": [
    {
      "name": "tm500-pairing",
      "rule": "RULE-1",
      "bidirectional": true,
      "requires": {
        "ue": "TM500"
      },
      "implies": {
        "ru": "TM500"
      },
      "reason": "The TM500 emulates UE and RU as one instrument: a TM500 UE runs only against the TM500 RU emulation, and vice-versa."
    },
    {
      "name": "aerial-requires-dgx-spark",
      "rule": "RULE-7",
      "bidirectional": true,
      "requires": {
        "l1_backend": "Aerial-cuBB"
      },
      "implies": {
        "server": "DGX-Spark"
      },
      "reason": "Aerial cuBB requires the DGX-Spark GB10 + ConnectX-7 hardware; it cannot run on joule, and DGX-Spark is present in this testbed only as the Aerial L1 host."
    },
    {
      "name": "aerial-is-monolithic-only",
      "rule": "RULE-10",
      "bidirectional": false,
      "requires": {
        "l1_backend": "Aerial-cuBB"
      },
      "implies": {
        "gnb_split": "monolithic"
      },
      "reason": "Aerial is a High-PHY (L1) backend that the gNB stack sits on top of, and in this testbed it is wired to a MONOLITHIC gNB only (OCUDU or OAI): there is no CU+DU split \u2014 same-vendor or mixed \u2014 when Aerial is the L1 backend. Selecting Aerial with any non-monolithic split is rejected; selecting Aerial with no split auto-resolves it to monolithic."
    }
  ],
